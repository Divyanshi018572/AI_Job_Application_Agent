# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used for auth email links and OAuth redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy fallback (optional if you still use anon key naming)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here

# Groq AI Cloud (Ultra-Fast Inference for Tailoring & Drafting)
GROQ_API_KEY=your-groq-api-key-here

# Tavily Search — used for company token discovery (Task 2.2), in place of
# the plan's original Brave Search spec (documented provider swap, see
# AUDIT_AND_ROADMAP.md; Brave's free tier requires a card, Tavily's doesn't).
# Get a key at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here
