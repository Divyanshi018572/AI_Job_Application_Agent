# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vendored skill marketplaces (each contains its own nested .git — never track as a submodule/gitlink)
/harness-skills/

# vercel
.vercel

# supabase CLI local cache/state
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts
